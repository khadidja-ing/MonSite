# Modèle de configuration. Copiez ce fichier en ".env" pour un usage local,
# ou renseignez ces valeurs dans les réglages de votre hébergeur.
# Ces valeurs ne sont PAS secrètes (elles sont visibles dans le navigateur).

# Adresse publique du site, sans "/" final.
VITE_SITE_URL=

# Adresse d'envoi du formulaire de contact (ex. Formspree).
VITE_CONTACT_FORM_ENDPOINT=
